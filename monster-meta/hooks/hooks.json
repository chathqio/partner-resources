{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-update.sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}"],
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "monster-meta",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-update.sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}"],
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
